# Existing Ollama adapter. Local Ollama does not require an API key.
SUPPORT_OLLAMA_BASE_URL=http://127.0.0.1:11434
SUPPORT_OLLAMA_MODEL=llama3.2:3b
SUPPORT_OLLAMA_API_KEY=
# Hard upper bound: 30 seconds. No automatic provider retries.
SUPPORT_OLLAMA_TIMEOUT=20

# KZT, charged separately from merchandise. Zero preserves the existing free delivery.
ORDER_DELIVERY_FEE=0.00

# Optional isolated database path; leave unset to use the existing db.sqlite3.
# JETFOOD_DATABASE_NAME=C:/path/to/jetfood-demo.sqlite3
