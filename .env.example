# Existing Ollama adapter. Local Ollama does not require an API key.
SUPPORT_OLLAMA_BASE_URL=http://127.0.0.1:11434
SUPPORT_OLLAMA_MODEL=llama3.2:3b
SUPPORT_OLLAMA_API_KEY=
# Hard upper bound: 30 seconds. No automatic provider retries.
SUPPORT_OLLAMA_TIMEOUT=20

# KZT, charged separately from merchandise. Zero preserves the existing free delivery.
ORDER_DELIVERY_FEE=0.00

# Optional isolated database path; leave unset to use the existing db.sqlite3.
# JETFOOD_DATABASE_NAME=C:/path/to/jetfood-demo.sqlite3
# Freedom Pay Kazakhstan: obtain test merchant credentials from the provider.
# Django loads root .env automatically. Explicit process environment variables take priority.
# This .env.example is only a template; never put real secrets in this tracked file.
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_TEST_MODE=1
FREEDOMPAY_TIMEOUT=15
# Public HTTPS backend origin reachable by provider callbacks (no trailing /api).
PAYMENTS_PUBLIC_URL=
PAYMENTS_RETURN_URL=http://localhost:4200/payments/return
# Legacy card simulator. Set to 1 for the original local simulation behavior.
PAYMENTS_ALLOW_LEGACY_SIMULATION=1
# Optional additional Django hosts. A valid PAYMENTS_PUBLIC_URL host is included automatically.
DJANGO_ALLOWED_HOSTS=
# local = conservative heuristic + administrator review; other values keep pending.
REVIEW_MODERATION_PROVIDER=local
# Calendar-month boundaries for JetPoints levels.
JETPOINTS_TIME_ZONE=Asia/Qyzylorda
